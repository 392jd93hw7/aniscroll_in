PORT=3000
NODE_ENV=development
# Number of trusted reverse-proxy hops. Codespaces usually uses 1.
# Use 0 to disable proxy trust when the app is directly exposed.
TRUST_PROXY=1
# Sources are ordered from primary to fallback.
ANIMEPAHE_PRIMARY_URL=https://animepahe.ch
ANIMEPAHE_FALLBACK_URL=https://animepahe.ng
HTTP_TIMEOUT_MS=10000
HTTP_RETRIES=1
CACHE_DEFAULT_TTL_SECONDS=300
CACHE_TTL_SEARCH_SECONDS=120
CACHE_TTL_METADATA_SECONDS=1800
CACHE_MAX_ENTRIES=500
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
# Use * for public CORS, or comma-separated origins for production.
CORS_ORIGINS=*
LOG_LEVEL=info
